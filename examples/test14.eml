
module m1 :
  sig
    type A = int;
    val x : A -> A;
  end = struct
          type A = int;
          let x : A -> A = fun (a) -> a;
        end;

module m2 :
  sig
    type B = string;
    val y : B -> B;
  end = struct
          type B = string;
          let y : B -> B = fun (b) -> b;
        end;

module merge :
  ( sig type A = int;    val x : A -> A; end )
  ->m ( sig type B = string; val y : B -> B; end )
  ->m ( sig type A = int;    val x : A -> A; end
        ++
        sig type B = string; val y : B -> B; end )
  = functor (a) (b) -> a ++ b;

module m3 = merge(m1)(m2);

let useX : int    = (m3.x :: int -> int)(42);
let useY : string = (m3.y :: string -> string)("hi");
